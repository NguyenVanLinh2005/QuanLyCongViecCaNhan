<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FE"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarBackup"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4318FF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Sao Lưu &amp; Chia Sẻ Dữ Liệu"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💾 Trạng Thái Sao Lưu"
                        android:textColor="#2B3674"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvTotalBackupTasks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số công việc hiện tại: 0"
                        android:textColor="#2B3674"
                        android:textSize="15sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Định dạng xuất: Báo cáo văn bản chi tiết (Text/JSON)"
                        android:textColor="#A3AED0"
                        android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Preview -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄 Xem Trước Báo Cáo"
                        android:textColor="#2B3674"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etBackupPreview"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="#F4F7FE"
                        android:padding="12dp"
                        android:gravity="top|start"
                        android:textColor="#2B3674"
                        android:textSize="13sp"
                        android:focusable="false"
                        android:cursorVisible="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareBackup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📤 XUẤT &amp; CHIA SẺ BÁO CÁO"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="#4318FF"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyBackup"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📋 SAO CHÉP VÀO BỘ NHỚ TẠM"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:textColor="#4318FF"
                app:strokeColor="#4318FF"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
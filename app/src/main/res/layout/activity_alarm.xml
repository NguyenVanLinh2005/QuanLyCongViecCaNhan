<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FFFFFF">

    <!-- Chiếc chuông sẽ được lập trình để rung lắc -->
    <ImageView
        android:id="@+id/imgBell"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_popup_reminder"
        app:tint="#FF9800"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰ Sắp đến hạn!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#EE5D50"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvAlarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên công việc"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2B3674"
        android:gravity="center"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvAlarmDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mô tả chi tiết"
        android:textSize="14sp"
        android:textColor="#A3AED0"
        android:layout_marginTop="8dp"
        android:gravity="center"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="ĐÃ HIỂU &amp; ĐÓNG"
        app:cornerRadius="12dp"
        app:backgroundTint="#4318FF"
        android:layout_marginTop="24dp"/>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FE"
    android:fitsSystemWindows="true">

    <!-- Toolbar Header -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarStats"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4318FF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Báo Cáo &amp; Thống Kê Tiến Độ"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero Progress Card (Báo cáo phần trăm) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 TIẾN ĐỘ HOÀN THÀNH TỔNG THỂ"
                        android:textColor="#A3AED0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <FrameLayout
                        android:layout_width="140dp"
                        android:layout_height="140dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/circularProgress"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            app:indicatorSize="135dp"
                            app:trackThickness="12dp"
                            app:indicatorColor="#4318FF"
                            app:trackColor="#E0E7FF"
                            app:trackCornerRadius="6dp"
                            android:progress="0" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvPercentText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#4318FF"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đạt được"
                                android:textColor="#A3AED0"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvProgressSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã hoàn thành 0/0 công việc"
                        android:textColor="#2B3674"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grid 3 Thẻ Trạng Thái -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Thẻ Tổng Số -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvTotalTasksCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#4318FF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tổng số"
                            android:textColor="#A3AED0"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ Đã Xong -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvCompletedTasksCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#05CD99"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đã xong"
                            android:textColor="#A3AED0"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ Đang Chờ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvPendingTasksCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFCE20"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chờ xử lý"
                            android:textColor="#A3AED0"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Card Mức Độ Ưu Tiên & Yêu Thích -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 PHÂN LOẠI THEO MỨC ĐỘ ƯU TIÊN"
                        android:textColor="#A3AED0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvFavoriteTasks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Việc quan trọng / Yêu thích: 0"
                        android:textSize="15sp"
                        android:textColor="#4318FF"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvHighPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔴 Ưu tiên Cao: 0"
                        android:textSize="15sp"
                        android:textColor="#EE5D50"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvMedPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟡 Ưu tiên Vừa: 0"
                        android:textSize="15sp"
                        android:textColor="#D99B00"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvLowPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Ưu tiên Thấp: 0"
                        android:textSize="15sp"
                        android:textColor="#05CD99"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Thống Kê Theo Danh Mục -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏷️ PHÂN LOẠI THEO DANH MỤC"
                        android:textColor="#A3AED0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvCatWork"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💼 Công việc: 0"
                        android:textSize="14sp"
                        android:textColor="#2B3674"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvCatStudy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚 Học tập: 0"
                        android:textSize="14sp"
                        android:textColor="#2B3674"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvCatPersonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 Cá nhân: 0"
                        android:textSize="14sp"
                        android:textColor="#2B3674"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvCatHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏥 Sức khỏe: 0"
                        android:textSize="14sp"
                        android:textColor="#2B3674"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvCatFinance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 Tài chính: 0"
                        android:textSize="14sp"
                        android:textColor="#2B3674"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút Quay lại -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="QUAY LẠI TRANG CHỦ"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="#4318FF"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
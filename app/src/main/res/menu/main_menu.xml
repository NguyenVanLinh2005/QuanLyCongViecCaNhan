<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Nút Lịch công việc (Nổi bật trên Toolbar) -->
    <item
        android:id="@+id/action_calendar"
        android:icon="@android:drawable/ic_menu_today"
        android:title="Lịch công việc"
        app:showAsAction="always" />

    <!-- Nút Mở nhanh Thống kê (Nổi bật trên Toolbar) -->
    <item
        android:id="@+id/action_stats"
        android:icon="@android:drawable/ic_menu_sort_by_size"
        android:title="Thống kê tiến độ"
        app:showAsAction="always" />

    <!-- Nút Tìm kiếm (Nổi bật trên Toolbar) -->
    <item
        android:id="@+id/action_search"
        android:icon="@android:drawable/ic_menu_search"
        android:title="Tìm kiếm"
        app:showAsAction="always|collapseActionView"
        app:actionViewClass="androidx.appcompat.widget.SearchView" />

    <!-- Các mục trong Menu 3 chấm (Dropdown Popup Menu) -->
    <item
        android:id="@+id/action_clear_completed"
        android:icon="@android:drawable/ic_menu_delete"
        android:title="Dọn dẹp việc đã xong"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_export_backup"
        android:icon="@android:drawable/ic_menu_share"
        android:title="Sao lưu &amp; Chia sẻ danh sách"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_reset_all"
        android:icon="@android:drawable/ic_menu_close_clear_cancel"
        android:title="Xóa toàn bộ dữ liệu"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_app_info"
        android:icon="@android:drawable/ic_menu_info_details"
        android:title="Thông tin Ứng dụng &amp; Tác giả"
        app:showAsAction="never" />
</menu>
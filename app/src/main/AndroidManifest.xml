<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.quanlycongvieccanhan">

    <!-- Cấp quyền gửi thông báo và đặt báo thức -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuanLyCongViecCaNhan">

        <!-- KHAI BÁO BỘ NHẬN TÍN HIỆU BÁO THỨC -->
        <receiver android:name=".NotificationReceiver" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AlarmActivity"
            android:theme="@style/Theme.MaterialComponents.DayNight.Dialog"
            android:exported="false" />
        <activity android:name=".ThongKeActivity" />
        <activity android:name=".CalendarActivity" />
        <activity android:name=".AddTaskActivity" />
        <activity android:name=".TaskDetailActivity" />
        <activity android:name=".CategoryActivity" />
        <activity android:name=".CleanCompletedActivity" />
        <activity android:name=".BackupRestoreActivity" />
        <activity android:name=".AppInfoActivity" />
    </application>
</manifest>